# Copia este archivo a .env (no se sube a Git).
DB_PASSWORD=orvex_dev
DB_ROOT_PASSWORD=root_dev

# Puertos en tu máquina (cámbialos si ya están ocupados por otro programa)
DB_PORT=3306
API_PORT=8080
WEB_PORT=3000

# Secreto para firmar las sesiones (JWT). Mínimo 32 caracteres. En producción usa uno largo y aleatorio.
JWT_SECRET=solo-desarrollo-cambiar-este-secreto-en-produccion
# Cuentas de demostración *@orvex.demo (una por rol). Pon false fuera de desarrollo.
ORVEX_DEMO=true
ORVEX_DEMO_CONTRASENA=Orvex2026!
MAIL_PORT=8025

# Cola de eventos (RabbitMQ). Consola: http://localhost:15672
RABBIT_USUARIO=orvex
RABBIT_CLAVE=orvex_dev
RABBIT_CONSOLA_PORT=15672

# Monitoreo (perfil "monitoreo"): docker compose --profile monitoreo up -d
GRAFANA_CLAVE=orvex_dev
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
